{
  "name": "caltrain-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Caltrain timetables as a remote MCP server with an interactive timetable UI (MCP Apps), on Next.js",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gtfs:fetch": "rm -rf data/gtfs/caltrain-ca-us && mkdir -p data/gtfs/caltrain-ca-us && curl -fsSL https://data.trilliumtransit.com/gtfs/caltrain-ca-us/caltrain-ca-us.zip -o /tmp/caltrain-gtfs.zip && unzip -oq /tmp/caltrain-gtfs.zip -d data/gtfs/caltrain-ca-us",
    "gtfs:compile": "tsx scripts/compile-gtfs.ts",
    "widget:build": "vite build --config widget/vite.config.ts",
    "widget:dev": "vite build --config widget/vite.config.ts --watch",
    "generate": "npm run gtfs:compile && npm run widget:build",
    "dev": "npm run generate && next dev",
    "build": "npm run generate && next build",
    "start": "next start",
    "typecheck": "npm run generate && tsc --noEmit",
    "test": "npm run generate && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
